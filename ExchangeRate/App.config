<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data" />
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
  </configSections>
  <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
    <providers>
      <add name="XmlDbSettingProvider" type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data" resourcePath="App_Data\SpNames.xml" enableWatching="1" />
    </providers>
  </Fanex.Data.DbSettingProvider>
  <connectionStrings>
    <add name="SVRAGE.RepDB.aplweb" connectionString="packet size=4096; Data Source=10.18.200.232\sql2012;Initial Catalog=RepDB;Connect Timeout=600;integrated security=false; user id=aplweb; password=QYN7k+nZC5A==" providerName="System.Data.SqlClient" />
    <add name="SVRTXN.TransDB.aplweb" connectionString="packet size=4096; Data Source=10.18.200.230\sql2012;Initial Catalog=TransDB;Connect Timeout=600;integrated security=false; user id=aplweb; password=QYN7k+nZC5A==" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <Fanex.Logging msmqPath="FormatName:DIRECT=TCP:10.18.200.209\private$\entlib" defaultCategory="Apollo-Exchange-Service" />
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
  <appSettings>
    <add key="OandaUrl" value="https://www.oanda.com/rates/api/v1/rates/{0}.csv?quote={1}&amp;fields=averages&amp;date={2}&amp;api_key={3}" />
    <add key="OandaAPIKey" value="oneworksOanda" />
    <add key="BaseCurrencies" value="USD,EUR,MYR,CNY,IDR,AUD,CHF,GBP,SGD,THB,VND,KRW,JPY" />
    <!--For update history data. Data will be updated from date to day with every from currency.-->
    <add key="UpdateOldData" value="1" />
    <add key="RateDateFrom" value="06/02/2015" />
    <add key="RateDateTo" value="06/02/2015" />
    <add key="FromCurrencies" value="VND;USD" />
  </appSettings>
</configuration>